#!/usr/bin/env bash
NOTES_ROOT="$NOTES_CLI_HOME"

cmd_edit() {
    notes ls -ro |
        awk '{print $1 "\t" $0}' |
        fzf --delimiter="\t" --with-nth=2 \
            --preview="bat --color=always $NOTES_ROOT/{1}" \
            --preview-window=up:60% |
        awk -F'\t' '{print $1}' |
        xargs -I{} $EDITOR "$NOTES_ROOT/{}"
}

# 引数が空、または "e" / "edit" の場合はデフォルトでノートを開く
# それ以外の引数が渡された場合は、元の `notes` コマンドにそのまま引き渡す
case "${1:-}" in
    ""|e|edit)
        cmd_edit
        ;;
    *)
        notes "$@"
        ;;
esac
